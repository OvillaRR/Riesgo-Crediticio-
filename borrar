@dataclass
class Config:
    target_col: str = "target"

    random_state: int = 42
    test_size: float = 0.20

    batch_size: int = 256
    ul_batch_size: int = 512
    eval_batch_size: int = 1024

    num_epochs: int = 100
    learning_rate: float = 1e-3
    weight_decay: float = 1e-4

    hidden1: int = 256
    hidden2: int = 128
    dropout: float = 0.20

    epsilon: float = 0.5
    xi: float = 1e-6
    num_power_iterations: int = 1
    lambda_vat: float = 1.0

    patience: int = 10
    min_auc_gain: float = 0.001

    missing_numeric_value: float = -1.0

    device: str = "cuda" if torch.cuda.is_available() else "cpu"


args = Config()


# ============================================================
# 2) UTILIDADES
# ============================================================

def set_seed(seed=42):
    np.random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


set_seed(args.random_state)


def ks_statistic(y_true, y_score):
    fpr, tpr, _ = roc_curve(y_true, y_score)
    return np.max(tpr - fpr)


def clean_feature_lists(df, cat_cols, num_cols):
    """
    Quita columnas vacías o constantes.
    """
    keep_cat = []
    keep_num = []

    for c in cat_cols:
        if c not in df.columns:
            continue
        if df[c].isna().all():
            continue
        if df[c].nunique(dropna=False) <= 1:
            continue
        keep_cat.append(c)

    for c in num_cols:
        if c not in df.columns:
            continue
        if df[c].isna().all():
            continue
        if df[c].nunique(dropna=False) <= 1:
            continue
        keep_num.append(c)

    removed_cat = sorted(set(cat_cols) - set(keep_cat))
    removed_num = sorted(set(num_cols) - set(keep_num))

    print(f"Categóricas removidas: {len(removed_cat)}")
    print(f"Numéricas removidas: {len(removed_num)}")

    return keep_cat, keep_num, removed_cat, removed_num


# ============================================================
# 3) PREPARACIÓN DE DATOS TABULARES PARA VAT
# ============================================================

def prepare_vat_tabular_data(
    df,
    target_col,
    num_cols,
    cat_cols=None,
    test_size=0.20,
    random_state=42,
    batch_size=256,
    ul_batch_size=512,
    eval_batch_size=1024,
    missing_numeric_value=-1.0
):
    df = df.copy()

    if cat_cols is None:
        cat_cols = []

    # Validaciones básicas
    if target_col not in df.columns:
        raise ValueError(f"No existe target_col='{target_col}' en df.")

    cat_cols, num_cols, removed_cat, removed_num = clean_feature_lists(
        df=df,
        cat_cols=cat_cols,
        num_cols=num_cols
    )

    # target 0/1 = etiquetados
    # target -1 = no etiquetados
    labeled_mask = df[target_col].isin([0, 1])
    unlabeled_mask = df[target_col].isin([-1])

    df_labeled = df.loc[labeled_mask].copy()
    df_unlabeled = df.loc[unlabeled_mask].copy()

    if df_labeled.empty:
        raise ValueError("No hay observaciones etiquetadas con target 0/1.")

    if df_unlabeled.empty:
        print("Advertencia: no hay observaciones no etiquetadas target=-1.")

    print("Etiquetados:", df_labeled.shape)
    print("No etiquetados:", df_unlabeled.shape)

    y_labeled = df_labeled[target_col].astype(int).values

    X_labeled = df_labeled[num_cols + cat_cols].copy()
    X_unlabeled = df_unlabeled[num_cols + cat_cols].copy()

    # --------------------------------------------------------
    # Missing flags para numéricas
    # --------------------------------------------------------
    missing_flag_cols = []

    for c in num_cols:
        flag_col = f"{c}_isna"

        X_labeled[flag_col] = X_labeled[c].isna().astype(np.float32)

        if len(X_unlabeled) > 0:
            X_unlabeled[flag_col] = X_unlabeled[c].isna().astype(np.float32)
        else:
            X_unlabeled[flag_col] = pd.Series(dtype=np.float32)

        missing_flag_cols.append(flag_col)

    # --------------------------------------------------------
    # Numéricas: NaN -> -1
    # --------------------------------------------------------
    X_labeled[num_cols] = X_labeled[num_cols].fillna(missing_numeric_value)

    if len(X_unlabeled) > 0:
        X_unlabeled[num_cols] = X_unlabeled[num_cols].fillna(missing_numeric_value)

    # Convertir numéricas
    for c in num_cols:
        X_labeled[c] = pd.to_numeric(X_labeled[c], errors="coerce").fillna(missing_numeric_value)

        if len(X_unlabeled) > 0:
            X_unlabeled[c] = pd.to_numeric(X_unlabeled[c], errors="coerce").fillna(missing_numeric_value)

    # --------------------------------------------------------
    # Categóricas: missing -> "__MISSING__" + OrdinalEncoder
    # --------------------------------------------------------
    encoder = None

    if len(cat_cols) > 0:
        for c in cat_cols:
            X_labeled[c] = (
                X_labeled[c]
                .astype("object")
                .where(~X_labeled[c].isna(), "__MISSING__")
                .astype(str)
            )

            if len(X_unlabeled) > 0:
                X_unlabeled[c] = (
                    X_unlabeled[c]
                    .astype("object")
                    .where(~X_unlabeled[c].isna(), "__MISSING__")
                    .astype(str)
                )

        encoder = OrdinalEncoder(
            handle_unknown="use_encoded_value",
            unknown_value=-1
        )

        X_labeled[cat_cols] = encoder.fit_transform(X_labeled[cat_cols])

        if len(X_unlabeled) > 0:
            X_unlabeled[cat_cols] = encoder.transform(X_unlabeled[cat_cols])

    # --------------------------------------------------------
    # Escalamiento de numéricas reales
    # Ojo: se escalan después de meter -1.
    # No escalamos flags ni categóricas.
    # --------------------------------------------------------
    scaler = StandardScaler()

    X_labeled[num_cols] = scaler.fit_transform(X_labeled[num_cols])

    if len(X_unlabeled) > 0:
        X_unlabeled[num_cols] = scaler.transform(X_unlabeled[num_cols])

    # --------------------------------------------------------
    # Orden final de columnas
    # --------------------------------------------------------
    feature_cols = num_cols + missing_flag_cols + cat_cols

    X_labeled = X_labeled[feature_cols].astype(np.float32)

    if len(X_unlabeled) > 0:
        X_unlabeled = X_unlabeled[feature_cols].astype(np.float32)
    else:
        X_unlabeled = pd.DataFrame(columns=feature_cols).astype(np.float32)

    # --------------------------------------------------------
    # Train / Valid solo con etiquetados
    # --------------------------------------------------------
    X_train, X_valid, y_train, y_valid = train_test_split(
        X_labeled.values,
        y_labeled,
        test_size=test_size,
        random_state=random_state,
        stratify=y_labeled
    )

    # --------------------------------------------------------
    # Tensores
    # --------------------------------------------------------
    t_X_train = torch.tensor(X_train, dtype=torch.float32)
    t_y_train = torch.tensor(y_train, dtype=torch.long)

    t_X_valid = torch.tensor(X_valid, dtype=torch.float32)
    t_y_valid = torch.tensor(y_valid, dtype=torch.long)

    t_X_unlabeled = torch.tensor(X_unlabeled.values, dtype=torch.float32)

    # --------------------------------------------------------
    # Dataloaders
    # --------------------------------------------------------
    labeled_loader = DataLoader(
        TensorDataset(t_X_train, t_y_train),
        batch_size=batch_size,
        shuffle=True,
        drop_last=False
    )

    valid_loader = DataLoader(
        TensorDataset(t_X_valid, t_y_valid),
        batch_size=eval_batch_size,
        shuffle=False,
        drop_last=False
    )

    if len(t_X_unlabeled) > 0:
        unlabeled_loader = DataLoader(
            TensorDataset(t_X_unlabeled),
            batch_size=ul_batch_size,
            shuffle=True,
            drop_last=False
        )
    else:
        unlabeled_loader = None

    return {
        "labeled_loader": labeled_loader,
        "unlabeled_loader": unlabeled_loader,
        "valid_loader": valid_loader,

        "X_train": t_X_train,
        "y_train": t_y_train,
        "X_valid": t_X_valid,
        "y_valid": t_y_valid,
        "X_unlabeled": t_X_unlabeled,

        "num_features": len(feature_cols),
        "feature_cols": feature_cols,
        "num_cols": num_cols,
        "cat_cols": cat_cols,
        "missing_flag_cols": missing_flag_cols,

        "encoder": encoder,
        "scaler": scaler,

        "removed_cat": removed_cat,
        "removed_num": removed_num
    }


# ============================================================
# 4) RED NEURONAL TABULAR
# ============================================================

class TabularVATNetwork(nn.Module):
    def __init__(
        self,
        num_features,
        num_classes=2,
        hidden1=256,
        hidden2=128,
        dropout=0.20
    ):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(num_features, hidden1),
            nn.BatchNorm1d(hidden1),
            nn.LeakyReLU(0.1),
            nn.Dropout(dropout),

            nn.Linear(hidden1, hidden2),
            nn.BatchNorm1d(hidden2),
            nn.LeakyReLU(0.1),
            nn.Dropout(dropout),

            nn.Linear(hidden2, num_classes)
        )

    def forward(self, x):
        return self.net(x)


# ============================================================
# 5) VAT FUNCTIONS
# ============================================================

def _l2_normalize(d: torch.Tensor, eps: float = 1e-12) -> torch.Tensor:
    """
    Normaliza por muestra del batch.
    """
    d_flat = d.reshape(d.size(0), -1)
    d_norm = torch.norm(d_flat, p=2, dim=1, keepdim=True).clamp_min(eps)
    d = (d_flat / d_norm).reshape_as(d)
    return d


@contextlib.contextmanager
def _disable_tracking_bn_stats(model: nn.Module) -> Iterator[None]:
    """
    Desactiva temporalmente el tracking de running stats en BatchNorm.
    Evita contaminar BatchNorm con inputs perturbados.
    """
    def switch_attr(module: nn.Module):
        if isinstance(module, nn.modules.batchnorm._BatchNorm):
            module.track_running_stats ^= True

    model.apply(switch_attr)

    try:
        yield
    finally:
        model.apply(switch_attr)


def generate_virtual_adversarial_perturbation(
    model: nn.Module,
    x: torch.Tensor,
    logits: torch.Tensor,
    epsilon: float = 0.5,
    xi: float = 1e-6,
    num_power_iterations: int = 1
) -> torch.Tensor:
    """
    Aproxima r_vadv mediante power iteration.
    """
    d = torch.randn_like(x)

    with _disable_tracking_bn_stats(model):
        for _ in range(num_power_iterations):
            d = xi * _l2_normalize(d)
            d.requires_grad_()

            logits_perturbed = model(x + d)

            prob_clean = F.softmax(logits.detach(), dim=1)
            log_prob_perturbed = F.log_softmax(logits_perturbed, dim=1)

            dist = F.kl_div(
                log_prob_perturbed,
                prob_clean,
                reduction="batchmean"
            )

            grad = torch.autograd.grad(
                dist,
                d,
                retain_graph=False,
                create_graph=False,
                only_inputs=True
            )[0]

            d = grad.detach()

    r_vadv = epsilon * _l2_normalize(d)

    return r_vadv


def virtual_adversarial_loss(
    model: nn.Module,
    x: torch.Tensor,
    logits: torch.Tensor,
    epsilon: float = 0.5,
    xi: float = 1e-6,
    num_power_iterations: int = 1
) -> torch.Tensor:
    """
    VAT loss:
    KL( p(y|x) || p(y|x + r_vadv) )
    """
    r_vadv = generate_virtual_adversarial_perturbation(
        model=model,
        x=x,
        logits=logits,
        epsilon=epsilon,
        xi=xi,
        num_power_iterations=num_power_iterations
    )

    with _disable_tracking_bn_stats(model):
        logits_clean = logits.detach()
        logits_perturbed = model(x + r_vadv)

    prob_clean = F.softmax(logits_clean, dim=1)
    log_prob_perturbed = F.log_softmax(logits_perturbed, dim=1)

    vat_loss = F.kl_div(
        log_prob_perturbed,
        prob_clean,
        reduction="batchmean"
    )

    return vat_loss


# ============================================================
# 6) EVALUACIÓN
# ============================================================

@torch.no_grad()
def evaluate_auc_ks(model, loader, device):
    model.eval()

    all_y = []
    all_p = []

    for x, y in loader:
        x = x.to(device)
        y = y.to(device)

        logits = model(x)
        proba = torch.softmax(logits, dim=1)[:, 1]

        all_y.append(y.detach().cpu().numpy())
        all_p.append(proba.detach().cpu().numpy())

    y_true = np.concatenate(all_y)
    y_score = np.concatenate(all_p)

    auc = roc_auc_score(y_true, y_score)
    prauc = average_precision_score(y_true, y_score)
    ks = ks_statistic(y_true, y_score)

    return auc, prauc, ks


# ============================================================
# 7) TRAIN VAT
# ============================================================

def train_vat_model(
    vat_data,
    config: Config
):
    device = config.device

    model = TabularVATNetwork(
        num_features=vat_data["num_features"],
        num_classes=2,
        hidden1=config.hidden1,
        hidden2=config.hidden2,
        dropout=config.dropout
    ).to(device)

    optimizer = optim.AdamW(
        model.parameters(),
        lr=config.learning_rate,
        weight_decay=config.weight_decay
    )

    labeled_loader = vat_data["labeled_loader"]
    unlabeled_loader = vat_data["unlabeled_loader"]
    valid_loader = vat_data["valid_loader"]

    best_auc = -np.inf
    best_ks = -np.inf
    best_prauc = -np.inf
    best_state = None
    patience_counter = 0

    history = []

    for epoch in range(1, config.num_epochs + 1):

        model.train()

        if unlabeled_loader is not None:
            unlabeled_iter = iter(unlabeled_loader)
        else:
            unlabeled_iter = None

        running_sup = 0.0
        running_vat = 0.0
        running_total = 0.0
        n_batches = 0

        for x_l, y_l in labeled_loader:

            x_l = x_l.to(device)
            y_l = y_l.to(device)

            optimizer.zero_grad()

            # -----------------------------
            # Loss supervisada
            # -----------------------------
            logits_l = model(x_l)
            loss_sup = F.cross_entropy(logits_l, y_l)

            # -----------------------------
            # Loss VAT no etiquetada
            # -----------------------------
            if unlabeled_iter is not None:
                try:
                    (x_ul,) = next(unlabeled_iter)
                except StopIteration:
                    unlabeled_iter = iter(unlabeled_loader)
                    (x_ul,) = next(unlabeled_iter)

                x_ul = x_ul.to(device)

                logits_ul = model(x_ul)

                loss_vat = virtual_adversarial_loss(
                    model=model,
                    x=x_ul,
                    logits=logits_ul,
                    epsilon=config.epsilon,
                    xi=config.xi,
                    num_power_iterations=config.num_power_iterations
                )
            else:
                loss_vat = torch.tensor(0.0, device=device)

            loss = loss_sup + config.lambda_vat * loss_vat

            loss.backward()
            optimizer.step()

            running_sup += loss_sup.item()
            running_vat += loss_vat.item()
            running_total += loss.item()
            n_batches += 1

        auc, prauc, ks = evaluate_auc_ks(
            model=model,
            loader=valid_loader,
            device=device
        )

        history.append({
            "epoch": epoch,
            "sup_loss": running_sup / max(n_batches, 1),
            "vat_loss": running_vat / max(n_batches, 1),
            "total_loss": running_total / max(n_batches, 1),
            "auc": auc,
            "prauc": prauc,
            "ks": ks
        })

        print(
            f"Epoch {epoch:03d} | "
            f"Sup Loss: {running_sup / max(n_batches, 1):.4f} | "
            f"VAT Loss: {running_vat / max(n_batches, 1):.4f} | "
            f"AUC: {auc:.5f} | "
            f"PRAUC: {prauc:.5f} | "
            f"KS: {ks:.5f}"
        )

        # Early stopping por AUC
        if auc > best_auc + config.min_auc_gain:
            best_auc = auc
            best_prauc = prauc
            best_ks = ks
            best_state = {
                k: v.detach().cpu().clone()
                for k, v in model.state_dict().items()
            }
            patience_counter = 0
        else:
            patience_counter += 1

        if patience_counter >= config.patience:
            print(f"Early stopping en epoch {epoch}")
            break

    if best_state is not None:
        model.load_state_dict(best_state)

    history_df = pd.DataFrame(history)

    return {
        "model": model,
        "history": history_df,
        "best_auc": best_auc,
        "best_prauc": best_prauc,
        "best_ks": best_ks
    }


# ============================================================
# 8) PREDICCIÓN / SCORING
# ============================================================

@torch.no_grad()
def predict_proba_vat(model, X_tensor, device):
    model.eval()
    model = model.to(device)

    X_tensor = X_tensor.to(device)
    logits = model(X_tensor)
    proba = torch.softmax(logits, dim=1)[:, 1]

    return proba.detach().cpu().numpy()


